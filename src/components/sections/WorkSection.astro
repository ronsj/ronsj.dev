---
import { work } from "../../data/work";
import ProjectAccordion from "../ProjectAccordion";
import SectionFrame from "./SectionFrame.astro";
---

<SectionFrame id={work.id} shape="orbits" kicker={work.kicker} title={work.title} body={work.body}>
  {/* Hydrates once the section scrolls near; until then it renders closed, with every description still in the markup. */}
  <ProjectAccordion client:visible projects={work.projects} />
</SectionFrame>
