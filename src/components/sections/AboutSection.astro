---
import { about } from "../../data/about";
import SectionFrame from "./SectionFrame.astro";
---

<SectionFrame id={about.id} shape="sphere" kicker={about.kicker} title={about.title}>
  <p class="max-w-[46ch] text-[clamp(18px,1.6vw,22px)] leading-[1.45] text-pretty text-body">{about.body}</p>
</SectionFrame>
