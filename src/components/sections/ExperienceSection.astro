---
import { experience } from "../../data/experience";
import SectionFrame from "./SectionFrame.astro";
---

<SectionFrame id={experience.id} shape="helix" kicker={experience.kicker} title={experience.title}>
  <p class="max-w-[46ch] text-[clamp(18px,1.6vw,22px)] leading-[1.45] text-pretty text-body">
    {experience.body}
  </p>
  <ul class="mt-5 flex flex-col gap-2">
    {
      experience.roles.map((r) => (
        <li class="grid grid-cols-[auto_1fr] items-baseline gap-3.5 border-t border-rule pt-2 text-sm leading-[1.35] sm:text-lg">
          <span class="font-mono font-medium text-accent-text">{r.years}</span>
          <span class="flex gap-1 items-baseline flex-wrap">
            <strong class="font-medium text-ink">{r.title}</strong>
            <span>@</span>
            <span class="leading-[1.7] text-muted">
              {r.companyUrl ? (
                <a href={r.companyUrl} class="link-underline" target="_blank" rel="noopener noreferrer">
                  {r.company}
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              ) : (
                r.company
              )}
            </span>
          </span>
        </li>
      ))
    }
  </ul>
</SectionFrame>
