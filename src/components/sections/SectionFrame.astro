---
import type { ShapeName } from "../../scripts/shapes";

/**
 * The shell every section shares: a full-height `data-section` section the scroll script watches, the
 * kicker, the optically aligned heading and the body paragraph. Anything after that is up to each
 * section (the slot).
 */
interface Props {
  /** Anchor id the nav jumps to. */
  id: string;
  /** The shape the particle field settles into while this section covers most of the viewport. */
  shape: ShapeName;
  kicker: string;
  title: string;
  /** The paragraph under the heading. */
  body?: string;
  /** Only the first section on the page should be an h1. */
  level?: "h1" | "h2";
  /** Size/wrap classes for the heading; the default suits a multi-word title. */
  titleClass?: string;
}

const {
  id,
  shape,
  kicker,
  title,
  body,
  level: Heading = "h2",
  titleClass = "text-[clamp(44px,7vw,96px)] text-balance",
} = Astro.props;
const titleId = `${id}-title`;

/**
 * Left side bearing of each heading's first glyph in Sora ExtraBold, in em (measured via canvas
 * `measureText`). Pulling the heading left by this much lines its ink up with the text below it.
 */
const bearings: Record<string, number> = { R: 0.074, P: 0.074, T: 0.02, S: 0.022, D: 0.074, I: 0.076, L: 0.074, K: 0.074 };
// Pulling by the full bearing reads as too far left, so use 80% of it.
const OPTICAL_FACTOR = 0.8;
const opticalOffset = `margin-left: -${((bearings[title[0] ?? ""] ?? 0) * OPTICAL_FACTOR).toFixed(4)}em`;
---

<section
  id={id}
  data-section
  data-shape={shape}
  aria-labelledby={titleId}
  tabindex="-1"
  class="flex min-h-svh flex-col justify-center pt-24 pb-20 outline-none"
>
  <p class="mb-[18px] ml-2 flex items-center gap-3 text-sm md:text-lg font-bold md:font-medium tracking-[0.08em] md:tracking-[0.18em] text-accent-text uppercase">
    <svg aria-hidden="true" width="32" height="10" viewBox="0 0 32 10" fill="none" class="block flex-none">
      <path
        d="M1 6.5C5 1.5 9 1.5 13 5s8 3.5 12 -1.5"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
      />
    </svg>
    {kicker}
  </p>
  <Heading
    id={titleId}
    style={opticalOffset}
    class:list={[
      "mb-[22px] font-display leading-[0.85] font-extrabold tracking-[-0.02em] text-box-cap",
      titleClass,
    ]}
  >
    {title}
  </Heading>
  {body && <p class="max-w-[46ch] text-[clamp(18px,1.6vw,22px)] leading-[1.45] text-pretty text-body">{body}</p>}
  <slot />
</section>
