---
import { gutter } from "../styles/layout";

/**
 * Fixed site header: the monogram (back to top), the primary nav and the theme toggle.
 * Nav jumps are handled by scripts/sections.ts, the toggle by scripts/theme.ts.
 */
---

<header
  class:list={[
    "fixed inset-x-0 top-0 z-10 flex items-center justify-between py-7 text-[15px] tracking-[0.02em]",
    // The copy scrolls under the header, so fade a backdrop in behind it.
    "bg-linear-to-b from-paper to-transparent",
    gutter,
  ]}
>
  <a
    href="#intro"
    class="font-display text-2xl font-bold tracking-[2px] transition-colors hover:text-accent-text"
    aria-label="Ron San Jose, back to top"
    >RSJ</a
  >
  <div class="flex items-center gap-[22px]">
    <nav aria-label="Primary" class="flex gap-[22px]">
      <a href="#work" class="border-b-2 border-transparent transition-colors hover:border-accent hover:text-accent-text">Work</a>
      <a href="#contact" class="border-b-2 border-transparent transition-colors hover:border-accent hover:text-accent-text">Contact</a>
    </nav>
    <button
      type="button"
      data-theme-toggle
      aria-label="Theme: auto"
      class="-mr-2 grid size-8 cursor-pointer place-items-center rounded-sm transition-colors hover:text-accent-text"
    >
      {/* One icon per mode, cycling auto → light → dark. The mode is `data-mode` on <html>, set before first paint. */}
      <svg aria-hidden="true" class="hidden in-data-[mode=auto]:block" width="18" height="18" viewBox="0 0 24 24" fill="none">
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8" />
        <path d="M12 3a9 9 0 0 1 0 18Z" fill="currentColor" />
      </svg>
      <svg aria-hidden="true" class="hidden in-data-[mode=light]:block" width="18" height="18" viewBox="0 0 24 24" fill="none">
        <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8" />
        <path
          d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        />
      </svg>
      <svg aria-hidden="true" class="hidden in-data-[mode=dark]:block" width="18" height="18" viewBox="0 0 24 24" fill="none">
        <path
          d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linejoin="round"
        />
      </svg>
    </button>
  </div>
</header>

<script>
  import { initTheme } from "../scripts/theme";

  initTheme(document);
</script>
