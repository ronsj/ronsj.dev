---
import { gutter } from "../styles/layout";

/** Fixed site header: the monogram (back to top) and the primary nav. Nav jumps are handled by scripts/stages.ts. */
---

<header
  class:list={[
    "fixed inset-x-0 top-0 z-10 flex items-center justify-between py-7 text-[15px] tracking-[0.02em]",
    // The copy scrolls under the header, so fade a backdrop in behind it.
    "bg-linear-to-b from-paper to-transparent",
    gutter,
  ]}
>
  <a
    href="#intro"
    class="font-display text-2xl font-bold tracking-[2px] transition-colors hover:text-accent-text"
    aria-label="Ron San Jose, back to top"
    >RSJ</a
  >
  <nav aria-label="Primary" class="flex gap-[22px]">
    <a href="#work" class="border-b-2 border-transparent transition-colors hover:border-accent hover:text-accent-text">Work</a>
    <a href="#contact" class="border-b-2 border-transparent transition-colors hover:border-accent hover:text-accent-text">Contact</a>
  </nav>
</header>
