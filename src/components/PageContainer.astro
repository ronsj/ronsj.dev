---
import ContactFormDialog from "./ContactFormDialog.astro";
import Header from "./Header.astro";
import { sections } from "./sections";
import { gutter } from "../styles/layout";

/** Number of particles in the field (1000–12000). */
const PARTICLE_COUNT = 5000;
---

<div data-story data-particles={PARTICLE_COUNT} class="relative">
  {/* Fixed behind the scrolling copy; the script morphs it to the shape of the section covering most of the viewport. */}
  <canvas data-canvas aria-hidden="true" class="pointer-events-none fixed inset-0 block size-full"></canvas>

  <Header />

  <main class:list={["relative w-[min(100%,720px)] @container", gutter]}>
    {sections.map((Section) => <Section />)}
  </main>

  <ContactFormDialog />
</div>

<script>
  import { initSections } from "../scripts/sections";

  const root = document.querySelector<HTMLElement>("[data-story]");
  if (root) initSections(root);
</script>
