---
import { stages } from "./stages";

interface Props {
  /** Number of particles in the field (1000–12000). */
  particles?: number;
}

const { particles = 5000 } = Astro.props;
const gutter = "px-[clamp(20px,5vw,64px)]";

// Turnstile widget for the contact form. Public, so it's baked in; tests build with a dummy sitekey.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "0x4AAAAAAE8wGzGjBwHSydBN";
---

<div
  data-story
  data-particles={particles}
  class="relative bg-paper"
  style={`height: ${stages.length * 100}vh`}
>
  {
    stages.map((s, i) => (
      <span id={s.id} data-anchor class="absolute left-0" style={`top: ${i * 100}vh`} />
    ))
  }

  <div class="sticky top-0 h-dvh overflow-hidden">
    <canvas data-canvas aria-hidden="true" class="absolute inset-0 block size-full"></canvas>

    <header
      class:list={[
        "absolute inset-x-0 top-0 z-10 flex items-center justify-between py-7 text-[15px] tracking-[0.02em]",
        // Below desktop the particles pass under the header, so fade a white backdrop in behind it.
        "bg-linear-to-b from-white to-transparent lg:bg-none",
        gutter,
      ]}
    >
      <a
        href="#intro"
        class="font-display text-2xl font-bold tracking-[2px] transition-colors hover:text-accent-text"
        aria-label="Ron San Jose, back to top"
        >RSJ</a
      >
      <nav aria-label="Primary" class="flex gap-[22px]">
        <a href="#work" class="border-b-2 border-transparent transition-colors hover:border-accent hover:text-accent-text">Work</a>
        <a href="#contact" class="border-b-2 border-transparent transition-colors hover:border-accent hover:text-accent-text">Contact</a>
      </nav>
    </header>

    <main
      class:list={[
        "pointer-events-none absolute inset-y-0 left-0 flex w-[min(100%,720px)] flex-col justify-center pt-24 pb-20 @container",
        gutter,
      ]}
    >
      <div
        data-text
        data-visible="true"
        class="pointer-events-auto transition-[opacity,translate] duration-[280ms] ease-out data-[visible=false]:translate-y-3.5 data-[visible=false]:opacity-0 motion-reduce:transition-none"
      >
        {stages.map(({ Stage }, i) => <Stage active={i === 0} />)}
      </div>
    </main>

    <dialog
      data-email-dialog
      aria-labelledby="email-dialog-title"
      class="m-auto w-[min(100%-2rem,28rem)] rounded-md bg-paper p-6 text-ink shadow-2xl backdrop:bg-ink/40 sm:p-8"
    >
      <div class="mb-5 flex items-start justify-between gap-4">
        <h2 id="email-dialog-title" class="font-display text-2xl font-bold">Send me a message</h2>
        <button
          type="button"
          data-email-close
          aria-label="Close dialog"
          class="-mt-1 -mr-2 grid size-8 cursor-pointer place-items-center rounded-sm text-muted transition-colors hover:text-ink"
        >
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </button>
      </div>

      <form data-email-form class="flex flex-col gap-4">
        <div class="flex flex-col gap-1.5">
          <label for="email-name" class="text-sm font-medium">Name</label>
          <input
            id="email-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            maxlength="200"
            aria-describedby="email-name-error"
            class="rounded-sm border border-rule bg-white px-3 py-2 text-base aria-invalid:border-error"
          />
          <p id="email-name-error" data-error-for="name" hidden class="text-sm text-error"></p>
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="email-email" class="text-sm font-medium">Email</label>
          <input
            id="email-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            maxlength="320"
            aria-describedby="email-email-error"
            class="rounded-sm border border-rule bg-white px-3 py-2 text-base aria-invalid:border-error"
          />
          <p id="email-email-error" data-error-for="email" hidden class="text-sm text-error"></p>
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="email-message" class="text-sm font-medium">Message</label>
          <textarea
            id="email-message"
            name="message"
            required
            rows="5"
            maxlength="5000"
            aria-describedby="email-message-error"
            class="rounded-sm border border-rule bg-white px-3 py-2 text-base aria-invalid:border-error"
          ></textarea>
          <p id="email-message-error" data-error-for="message" hidden class="text-sm text-error"></p>
        </div>
        {/* Honeypot: invisible to people and skipped by assistive tech; bots tend to fill it. */}
        <div class="hidden" aria-hidden="true">
          <label>Company <input name="company" type="text" tabindex="-1" autocomplete="off" /></label>
        </div>
        {/* Turnstile renders here on demand; it adds its own hidden cf-turnstile-response input to the form. */}
        <div data-turnstile data-sitekey={turnstileSiteKey} class="min-h-[65px]"></div>
        <p data-email-status role="status" class="min-h-5 text-sm text-muted"></p>
        <div class="flex items-center justify-end gap-3">
          <button
            type="button"
            data-email-close
            class="cursor-pointer rounded-sm px-4 py-2.5 text-sm font-medium text-muted transition-colors hover:text-ink"
          >
            Cancel
          </button>
          <button
            type="submit"
            disabled
            class="cursor-pointer rounded-sm bg-accent px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accent-text disabled:cursor-default disabled:opacity-60"
          >
            Send
          </button>
        </div>
      </form>

      <div data-email-success hidden class="flex flex-col gap-5">
        <p class="text-lg leading-[1.45] text-body">
          Thanks ~ your message is on its way. I’ll reply to the address you gave.
        </p>
        <button
          type="button"
          data-email-close
          class="cursor-pointer self-end rounded-sm bg-accent px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accent-text"
        >
          Close
        </button>
      </div>
    </dialog>

    <nav
      aria-label="Sections"
      class="absolute right-[clamp(20px,5vw,64px)] bottom-8 flex items-center gap-4 text-sm tracking-[0.08em] lg:right-auto lg:left-[clamp(20px,5vw,64px)]"
    >
      <span aria-hidden="true" data-stage-num class="font-mono font-medium">01</span>
      <span class="relative block h-0.5 w-[120px] bg-rule">
        <span data-bar class="absolute inset-y-0 left-0 w-0 bg-accent transition-[width] duration-200 ease-linear motion-reduce:transition-none"
        ></span>
        <div class="absolute bottom-full left-1/2 mb-1 flex -translate-x-1/2 gap-4 text-muted">
          <button
            type="button"
            data-prev
            aria-label="Previous section"
            class="grid size-8 cursor-pointer place-items-center rounded-sm transition-colors hover:text-ink aria-disabled:cursor-default aria-disabled:opacity-40 aria-disabled:hover:text-muted"
          >
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path
                d="M3 10l5-5 5 5"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
          <button
            type="button"
            data-next
            aria-label="Next section"
            class="grid size-8 cursor-pointer place-items-center rounded-sm transition-colors hover:text-ink aria-disabled:cursor-default aria-disabled:opacity-40 aria-disabled:hover:text-muted"
          >
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path
                d="M3 6l5 5 5-5"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
        </div>
      </span>
      <span aria-hidden="true" class="font-mono text-muted">{String(stages.length).padStart(2, "0")}</span>
      <p data-live aria-live="polite" class="sr-only"></p>
    </nav>
  </div>
</div>

<script>
  import { initContactForm } from "../scripts/contact";
  import { initStages } from "../scripts/stages";

  const root = document.querySelector<HTMLElement>("[data-story]");
  if (root) {
    initStages(root);
    initContactForm(root);
  }
</script>
