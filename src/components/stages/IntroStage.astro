---
import { intro } from "../../data/intro";
import StageFrame from "./StageFrame.astro";
// The name always stays on one line: size it from the column width (the name is ~6.7em wide).
const titleClass = "text-[clamp(40px,14.5cqi,96px)] whitespace-nowrap lg:text-[96px]";
---

<StageFrame
  id={intro.id} shape="cloud"
  kicker={intro.role}
  title={intro.name}
  level="h1"
  {titleClass}
/>
