---
import { work } from "../../data/work";
import StageFrame from "./StageFrame.astro";

interface Props {
  active?: boolean;
}
const { active } = Astro.props;
---

<StageFrame id={work.id} shape="orbits" kicker={work.kicker} title={work.title} {active}>
  <p class="max-w-[46ch] text-[clamp(18px,1.6vw,22px)] leading-[1.45] text-pretty text-body">{work.body}</p>
  <ul class="mt-5 flex flex-col gap-2">
    {
      work.projects.map((p) => (
        <li class="grid grid-cols-[auto_1fr] items-baseline gap-3.5 border-t border-rule pt-2 text-sm leading-[1.35] sm:text-lg">
          <span aria-hidden="true" class="font-mono font-medium text-accent-text">
            ~
          </span>
          <span>
            <a href={p.url} class="link-underline" target="_blank" rel="noopener noreferrer">
              <strong class="font-medium">{p.name}</strong>
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
            <span class="block leading-[1.7] text-muted">{p.summary}</span>
          </span>
        </li>
      ))
    }
  </ul>
</StageFrame>
