---
import { Font } from "astro:assets";
import { contact } from "../data/contact";
import { skills } from "../data/skills";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Social share image, relative to the site root. 1200×630 works everywhere. */
  image?: string;
}

const SITE_NAME = "Ron San Jose";
const AUTHOR = "Ron San Jose";

const { title, description, image = "/og.png" } = Astro.props;
// `site` is set in astro.config.mjs, so these resolve to absolute production URLs even in dev/preview.
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);

// One graph, three linked nodes: the page is a profile of the person, and the site is authored by
// them. `@id`s let Google resolve all three to the same entity instead of guessing from the title.
const personId = new URL("#person", Astro.site).href;
const websiteId = new URL("#website", Astro.site).href;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": canonical.href,
      url: canonical.href,
      name: title,
      description,
      isPartOf: { "@id": websiteId },
      mainEntity: { "@id": personId },
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: Astro.site?.href,
      name: SITE_NAME,
      author: { "@id": personId },
    },
    {
      "@type": "Person",
      "@id": personId,
      name: AUTHOR,
      jobTitle: "Frontend and fullstack developer",
      description,
      url: Astro.site?.href,
      image: imageUrl.href,
      sameAs: contact.links.map((l) => l.href),
      knowsAbout: skills.groups.flatMap((g) => g.items),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* The paper colour of the theme in effect. Set before first paint by the inline script below (a media query would follow the system, not the stored choice), then kept in step by scripts/theme.ts. */}
    <meta name="theme-color" content="#f5f5f5" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${AUTHOR}, fullstack developer`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={`${AUTHOR}, fullstack developer`} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    {/* Set the theme before first paint so a stored choice doesn't flash the other theme. Inline on purpose; scripts/theme.ts takes over from here. */}
    <script is:inline>
      (() => {
        let mode = null;
        try {
          mode = localStorage.getItem("theme");
        } catch {}
        if (mode !== "light" && mode !== "dark" && mode !== "auto") mode = "light";
        const html = document.documentElement;
        const theme =
          mode === "auto" ? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light") : mode;
        html.dataset.mode = mode;
        html.dataset.theme = theme;
        // The --color-paper token of each theme in styles/global.css. The stylesheet may not have been parsed yet, so it can't be read here.
        const paper = { light: "#f5f5f5", dark: "#1c2230" }[theme];
        document.querySelector('meta[name="theme-color"]').content = paper;
      })();
    </script>

    <Font cssVariable="--font-manrope" preload />
    <Font cssVariable="--font-sora" preload />
    <Font cssVariable="--font-dm-mono" preload />
  </head>
  <body>
    <slot />
  </body>
</html>
